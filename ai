#!/bin/bash
###################################################################
# ai — Root CLI (stable interface) v1.1
#
# Fixes from v1.0:
# - --trace flag now properly passed through to runtime.sh
#   (was setting AI_TRACE=1 env var but runtime checks --trace flag)
###################################################################

set -euo pipefail

VERSION="1.1.0"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME="${SCRIPT_DIR}/scripts/runtime.sh"

# ---- Defaults ----
TRACE=0
ADAPTER=""
SHOW_VERSION=0

# ---- Parse global flags ----
ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --trace)
            TRACE=1
            shift
            ;;
        --adapter=*)
            ADAPTER="${1#*=}"
            shift
            ;;
        --version)
            SHOW_VERSION=1
            shift
            ;;
        --help|-h)
            echo "Usage: ai <command> [args]"
            echo ""
            echo "Commands:"
            echo "  run | explain | fix | refactor | query"
            echo ""
            echo "Global Options:"
            echo "  --trace            Enable step tracing"
            echo "  --adapter=NAME     Override adapter (e.g. agent, mock)"
            echo "  --model=TIER       Override model tier (fast|balanced|heavy)"
            echo "  --version          Show version"
            echo ""
            echo "Examples:"
            echo "  ai run 'analyze agent-sim architecture'"
            echo "  ai fix 'ImportError in runner.py' --trace"
            echo "  ai query 'what should I build next' --model=fast"
            exit 0
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# ---- Version ----
if [ "$SHOW_VERSION" -eq 1 ]; then
    echo "ai version $VERSION"
    exit 0
fi

# ---- Validate command ----
if [ ${#ARGS[@]} -eq 0 ]; then
    echo "Usage: ai <command> [args]"
    echo "Run 'ai --help' for full usage"
    exit 1
fi

# ---- Inject env overrides ----
# Note: AI_TRACE exported for any scripts that check env
# --trace flag also prepended to ARGS so runtime.sh receives it
[ "$TRACE" -eq 1 ] && export AI_TRACE=1
[ -n "$ADAPTER" ] && export AI_ADAPTER="$ADAPTER"

# ---- Build final args ----
# Prepend --trace flag so runtime.sh receives it as a positional flag
FINAL_ARGS=()
[ "$TRACE" -eq 1 ] && FINAL_ARGS+=("--trace")
FINAL_ARGS+=("${ARGS[@]}")

# ---- Execute runtime ----
exec bash "$RUNTIME" "${FINAL_ARGS[@]}"
