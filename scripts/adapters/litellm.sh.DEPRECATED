#!/bin/bash
###################################################################
# litellm.sh — LiteLLM Agent Adapter (MCP Structured v2)
#
# Features:
# - Structured message loop (no prompt stuffing)
# - MCP-style tool calls + tool results
# - Retry + error handling preserved
# - Backwards-safe output handling
###################################################################

set -euo pipefail

ADAPTER_NAME="litellm"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/../../.env"
TOOL_EXECUTOR="${SCRIPT_DIR}/../tool_executor.py"

source "${SCRIPT_DIR}/_base.sh"

COMMAND="${1:-}"
INPUT="${2:-}"

# ---- Load env ----
if [ -f "$ENV_FILE" ]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

# ---- Config ----
BASE_URL="${LITELLM_BASE_URL:-http://litellm:4000/v1}"
MODEL="${ACTIVE_MODEL:-fast}"
MASTER_KEY="${LITELLM_MASTER_KEY:-ai-dev-platform}"
TIMEOUT="${AI_TIMEOUT:-120}"
RETRIES="${AI_RETRIES:-2}"
MAX_STEPS="${AI_MAX_STEPS:-6}"

# ================================================================
# 🧠 VALIDATE
# ================================================================

if [ -z "$COMMAND" ]; then
  build_response "error" "Missing command" "invalid_request"
  adapter_exit
fi

# ================================================================
# 🧱 MESSAGE STATE
# ================================================================

MESSAGES="[]"

add_message() {
  local role="$1"
  local content="$2"

  MESSAGES=$(echo "$MESSAGES" | jq \
    --arg role "$role" \
    --arg content "$content" \
    '. + [{role: $role, content: $content}]')
}

add_tool_message() {
  local tool="$1"
  local json="$2"

  MESSAGES=$(echo "$MESSAGES" | jq \
    --arg tool "$tool" \
    --argjson content "$json" \
    '. + [{role: "tool", name: $tool, content: $content}]')
}

add_tool_call_message() {
  local tool="$1"
  local input="$2"

  MESSAGES=$(echo "$MESSAGES" | jq \
    --arg tool "$tool" \
    --argjson input "$input" \
    '. + [{
      role: "assistant",
      content: null,
      tool_call: {name: $tool, input: $input}
    }]')
}

# ================================================================
# 🧠 INITIAL MESSAGES
# ================================================================

SYSTEM="You are an AI agent.

Rules:
- When using a tool, respond ONLY with valid JSON:
{
  \"tool_call\": {
    \"name\": \"<tool_name>\",
    \"input\": { ... }
  }
}
- Do NOT include explanations when calling tools
- When task is complete, respond normally in plain text"

case "$COMMAND" in
  run|query) USER_PROMPT="${INPUT}" ;;
  fix) USER_PROMPT="Fix this: ${INPUT}" ;;
  explain) USER_PROMPT="Explain clearly: ${INPUT}" ;;
  refactor) USER_PROMPT="Refactor this: ${INPUT}" ;;
  *)
    build_response "error" "Unknown command: $COMMAND" "invalid_request"
    adapter_exit
    ;;
esac

MESSAGES=$(jq -n \
  --arg system "$SYSTEM" \
  --arg user "$USER_PROMPT" \
  '[
    {role: "system", content: $system},
    {role: "user", content: $user}
  ]')

# ================================================================
# 📦 REQUEST
# ================================================================

build_payload() {
  jq -n \
    --arg model "$MODEL" \
    --argjson messages "$MESSAGES" \
    '{
      model: $model,
      messages: $messages
    }'
}

request_once() {
  curl -sS \
    --connect-timeout 5 \
    --max-time "$TIMEOUT" \
    --retry 2 \
    --retry-delay 1 \
    --retry-connrefused \
    -X POST "${BASE_URL}/chat/completions" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${MASTER_KEY}" \
    -d "$(build_payload)"
}

# ================================================================
# 🔁 AGENT LOOP
# ================================================================

STEP=0

while [ "$STEP" -lt "$MAX_STEPS" ]; do
  STEP=$((STEP + 1))

  RESPONSE="$(request_once)"

  if [ -z "$RESPONSE" ] || ! json_valid "$RESPONSE"; then
    build_response "error" "Invalid response from LiteLLM" "api_error"
    adapter_exit
  fi

  if echo "$RESPONSE" | jq -e '.error' >/dev/null 2>&1; then
    ERR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // "Unknown error"')
    build_response "error" "$ERR_MSG" "api_error"
    adapter_exit
  fi

  OUTPUT=$(echo "$RESPONSE" | jq -r '
    .choices[0].message.content //
    empty
  ')

  if [ -z "$OUTPUT" ]; then
    build_response "error" "Empty response from model" "empty_response"
    adapter_exit
  fi

  # ============================================================
  # 🔍 TRY PARSE TOOL CALL JSON
  # ============================================================

  TOOL_CALL=$(echo "$OUTPUT" | jq -e '.' 2>/dev/null || echo "")

  if [ -n "$TOOL_CALL" ] && echo "$TOOL_CALL" | jq -e '.tool_call' >/dev/null 2>&1; then

    TOOL_NAME=$(echo "$TOOL_CALL" | jq -r '.tool_call.name')
    TOOL_INPUT=$(echo "$TOOL_CALL" | jq -c '.tool_call.input // {}')

    if [ -z "$TOOL_NAME" ] || [ "$TOOL_NAME" == "null" ]; then
      add_message "assistant" "$OUTPUT"
      continue
    fi

    # Record tool intent
    add_tool_call_message "$TOOL_NAME" "$TOOL_INPUT"

    # Execute tool
    TOOL_RESULT=$(python3 "$TOOL_EXECUTOR" "$TOOL_NAME" "$TOOL_INPUT")

    # Validate tool output
    if ! echo "$TOOL_RESULT" | jq -e '.' >/dev/null 2>&1; then
      TOOL_RESULT='{"status":"error","data":null,"error":{"message":"Invalid tool response","type":"contract_error"},"meta":{}}'
    fi

    # Append structured tool result
    add_tool_message "$TOOL_NAME" "$TOOL_RESULT"

    continue
  fi

  # ============================================================
  # ✅ FINAL ANSWER
  # ============================================================

  add_message "assistant" "$OUTPUT"

  build_response "done" "$OUTPUT" "" \
    "$(jq -n \
      --arg model "$MODEL" \
      --arg steps "$STEP" \
      '{model:$model, steps:$steps}')"

  adapter_exit

done

# ================================================================
# ❌ MAX STEPS HIT
# ================================================================

build_response "error" "Max agent steps reached" "limit_exceeded"
adapter_exit