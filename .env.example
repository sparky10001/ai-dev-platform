###################################################################
# AI Dev Platform — Environment Configuration (v8)
#
# Copy this file to .env and fill in values:
#
#   cp .env.example .env
#
# ================================================================
# Architecture
# ================================================================
#
# Runtime Flow:
#
#   ai
#    → runtime/engine.py
#    → scripts/adapters/agent.sh
#    → scripts/agent.py
#    → provider/model layer
#
# Provider Flow:
#
#   agent.py
#    → LiteLLM
#    → providers (ollama/openai/etc.)
#
# ================================================================
# Core Principles
# ================================================================
#
# - Runtime is schema-first
# - External contracts use JSON
# - Internal validation uses Pydantic v2
# - Traces are NDJSON replay-safe
# - Runtime adapter should remain "agent"
# - LiteLLM is the model/provider gateway
#
###################################################################

###################################################################
# 🧠 MODEL PROVIDER LAYER
#
# Controls logical provider routing.
#
# Options:
#
#   litellm   → primary production gateway
#   goose     → optional orchestration layer
#   mock      → offline/testing provider
#
# IMPORTANT:
# This is NOT the runtime adapter.
###################################################################

MODEL_PROVIDER=litellm

###################################################################
# 🔌 RUNTIME ADAPTER
#
# Runtime execution shim used by:
#
#   runtime/engine.py
#
# Valid adapters are resolved from:
#
#   scripts/adapters/<name>.sh
#
# Phase 3 architecture expects:
#
#   AI_ADAPTER=agent
#
# Do NOT set:
#
#   AI_ADAPTER=litellm
#
# unless a matching adapter script exists.
###################################################################

AI_ADAPTER=agent

###################################################################
# 🎯 ACTIVE MODEL
#
# Primary runtime model selector.
#
# Examples:
#
#   fast
#   general
#   code
#   claude
#
###################################################################

ACTIVE_MODEL=fast

###################################################################
# 🔁 FALLBACK CHAIN
#
# Provider/model fallback safety layer.
#
# NOTE:
# LiteLLM already supports provider fallback internally.
# This is only a last-resort runtime fallback.
###################################################################

FALLBACK_ENABLED=true
FALLBACK_CHAIN=mock

###################################################################
# 🌐 LITELLM CONFIGURATION
#
# Primary provider gateway.
###################################################################

LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=ai-dev-platform

###################################################################
# 🏠 OLLAMA BACKEND
#
# Used THROUGH LiteLLM.
#
# Runtime adapters should NOT call Ollama directly.
###################################################################

OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_MODEL=tinyllama

###################################################################
# ☁️ OPENAI BACKEND (OPTIONAL)
#
# Used THROUGH LiteLLM.
###################################################################

OPENAI_API_KEY=

###################################################################
# 🪿 GOOSE (OPTIONAL)
#
# Goose should target LiteLLM,
# not external providers directly.
###################################################################

GOOSE_ENABLED=true
GOOSE_PROVIDER=litellm
GOOSE_MODEL=fast

# Optional overrides
LITELLM_HOST=http://litellm:4000
LITELLM_TIMEOUT=180

###################################################################
# ⚙️ RUNTIME BEHAVIOR
###################################################################

AI_TIMEOUT=60
AI_RETRIES=2

AI_STREAM=false
AI_JSON_MODE=false

MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=512

###################################################################
# 📦 PROJECT CONTEXT
###################################################################

ACTIVE_PROJECT=

# Examples:
#
# ACTIVE_PROJECT=agent-sim
# ACTIVE_PROJECT=arb-agent-system

###################################################################
# 📁 RUNTIME STORAGE
#
# Phase 3 canonical runtime layout
###################################################################

AI_RUNS_DIR=/workspace/runs
AI_TRACE_DIR=/workspace/logs/traces
AI_EVAL_DIR=/workspace/logs/evals

###################################################################
# 🧪 DEBUG / DEVELOPMENT
###################################################################

AI_DEBUG=false
AI_RAW_OUTPUT=false
AI_DEBUG_FALLBACK=false

###################################################################
# 🔍 TRACE / REPLAY
#
# NDJSON replay-safe runtime traces
###################################################################

AI_TRACE=false

###################################################################
# 🧱 SCHEMA / CONTRACTS
#
# Runtime contracts are validated through:
#
#   runtime.schemas
#   runtime.validator
#   runtime.contracts
#
###################################################################

AI_SCHEMA_VERSION=1
AI_CONTRACT_VERSION=1

###################################################################
# 🧪 TESTING
#
# Recommended offline validation mode:
#
#   MODEL_PROVIDER=mock
#   AI_ADAPTER=agent
#
###################################################################